{
  "name": "school-events-hub",
  "version": "1.0.0",
  "description": "A unified school events hub that syncs calendars, sends timely reminders, and ensures parents never miss important school activities",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "test": "npm run test:server && npm run test:client",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "cd server && npm run lint",
    "lint:client": "cd client && npm run lint",
    "setup": "node scripts/dev-setup.js",
    "setup:db": "cd server && npm run migrate && npm run seed",
    "start": "cd server && npm start",
    "postinstall": "npm run setup:db"
  },
  "keywords": [
    "school",
    "events",
    "calendar",
    "notifications",
    "parent-communication",
    "education",
    "pta",
    "reminders"
  ],
  "author": "School Events Hub Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/school-events-hub.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/school-events-hub/issues"
  },
  "homepage": "https://github.com/your-org/school-events-hub#readme"
}